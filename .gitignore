.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj.user

# ── shinylive build output (regenerated by CI) ───────────────────────────
/_site/
app/_site/
docs/app/
site/

# ── stray R plot device output ───────────────────────────────────────────
Rplots.pdf
**/Rplots.pdf

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db


